{
  "name": "appshub-backend",
  "version": "1.0.0",
  "description": "Express.js backend for AppsHub marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed.ts",
    "lint": "eslint src --ext .ts"
